<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/HeadlessScreenReader.Domain/HeadlessScreenReader.Domain.csproj" />
    <ProjectReference Include="../../src/HeadlessScreenReader.Worker/HeadlessScreenReader.Worker.csproj" />
    <ProjectReference Include="../../src/HeadlessScreenReader.Exploration/HeadlessScreenReader.Exploration.csproj" />
    <ProjectReference Include="../../src/HeadlessScreenReader.ScreenReader/HeadlessScreenReader.ScreenReader.csproj" />
    <ProjectReference Include="../../src/HeadlessScreenReader.Browser.Playwright/HeadlessScreenReader.Browser.Playwright.csproj" />
    <ProjectReference Include="../../src/HeadlessScreenReader.Cli/HeadlessScreenReader.Cli.csproj" />
  </ItemGroup>
  <ItemGroup><Using Include="Xunit" /></ItemGroup>
  <ItemGroup>
    <!-- Launch the MCP application's own dependency closure. ASP.NET framework pruning in the
         test host must not turn copied application DLLs into a broken standalone deployment. -->
    <AssemblyMetadata Include="McpServerAssembly"
      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/HeadlessScreenReader.Mcp/bin/$(Configuration)/$(TargetFramework)/HeadlessScreenReader.Mcp.dll'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HeadlessScreenReader.Mcp\HeadlessScreenReader.Mcp.csproj" />
    <ProjectReference Include="..\..\src\HeadlessScreenReader.Egress\HeadlessScreenReader.Egress.csproj" />
  </ItemGroup>
</Project>
